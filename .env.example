# Copie este arquivo para ".env" (sem o .example) e preencha com sua chave real.
# Pegue sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Configuração da Evolution API (usada apenas pelo endpoint /webhook)
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_INSTANCE=nome-da-sua-instancia
EVOLUTION_API_KEY=apikey_da_instancia_na_evolution
WEBHOOK_SECRET=invente_um_token_aleatorio_bem_dificil